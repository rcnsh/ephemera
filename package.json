{
	"name": "ephemera",
	"private": true,
	"license": "MIT",
	"type": "module",
	"scripts": {
		"dev": "cf dev",
		"build": "cf build",
		"migrate": "sh -c '. ./.env && cf d1 migrations apply \"$D1_DATABASE_ID\"'",
		"deploy": "pnpm migrate && cf deploy",
		"typecheck": "EPHEMERA_TYPES_ONLY=1 cf workers types && tsc && tsc -p test",
		"test": "vitest run"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^2.0.0-beta.v.17",
		"@cloudflare/vitest-plugin": "^1.8.2",
		"cf": "^1.0.0-beta.32",
		"typescript": "^7.0.2",
		"vite": "^8.3.8",
		"vitest": "^5.1.0"
	},
	"dependencies": {
		"@cloudflare/puppeteer": "^1.4.0",
		"@modelcontextprotocol/server": "2.4.0",
		"agents": "^0.33.0",
		"fflate": "^0.8.3",
		"marked": "^18.2.0",
		"zod": "^4.6.7"
	}
}
