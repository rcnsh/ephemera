# Copy to .env and fill in (cloudflare.config.ts refuses to load without it). cf deploy and pnpm migrate read this file; keep it out of git.

# Hostname that serves the pages, the API and the MCP server.
PAGES_HOST=p.example.com
# Hostname of the dashboard, behind a Cloudflare Access application.
ADMIN_HOST=ephemera.example.com
# Audience (AUD) tag of that Access application.
ACCESS_AUD=replace-me
# ID of the D1 database, from `cf d1 create ephemera`. Used by pnpm migrate.
D1_DATABASE_ID=replace-me

# Optional: credentials for cf, if you don't use `cf auth login`.
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
